# Polygon — required. Get from https://polygon.io/dashboard/api-keys
POLYGON_API_KEY=

# Polygon plan tier — V5 features (historical trades, 4yr depth) require Developer or higher
# Allowed values: starter | developer | advanced
POLYGON_PLAN_TIER=developer

# FRED — for VIX. Free at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Finnhub — earnings calendar, news, analyst recs, insider transactions, peers
# Free at https://finnhub.io/dashboard
FINNHUB_API_KEY=
